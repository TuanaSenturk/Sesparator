@model KayitliAliciGirdisi
@{
    ViewData["Title"] = "Alıcıyı Düzenle";
    var id = ViewContext.RouteData.Values["id"];
}

<h1 class="mb-4">Alıcıyı Düzenle</h1>

<div class="row">
    <div class="col-xl-6 col-lg-8">
        <div class="card">
            <div class="card-body">
                <form asp-action="Duzenle" asp-route-id="@id" method="post">
                    <partial name="_AliciFormAlanlari" model="Model" />
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary"><i class="fas fa-check me-1"></i>Kaydet</button>
                        <a class="btn btn-outline-secondary" asp-action="Index">Vazgeç</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}