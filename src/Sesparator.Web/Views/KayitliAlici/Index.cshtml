@model List<KayitliAlici>
@{
    ViewData["Title"] = "Kayıtlı Alıcılar";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
    <div>
        <h1 class="mb-1">Kayıtlı Alıcılar</h1>
        <p class="text-muted mb-0">Sesli asistanda "Annem'e 500 TL gönder" derken kullanılan takma adlar.</p>
    </div>
    <a class="btn btn-primary" asp-action="Ekle"><i class="fas fa-plus me-1"></i>Yeni Alıcı</a>
</div>

@if (TempData["Mesaj"] is string mesaj)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="fas fa-circle-check me-1"></i>@mesaj
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Kapat"></button>
    </div>
}

@if (!Model.Any())
{
    <div class="alert alert-info">Henüz kayıtlı alıcınız yok.</div>
}
else
{
    <div class="card">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Takma ad</th>
                            <th>Ad soyad</th>
                            <th>IBAN</th>
                            <th class="text-end">İşlemler</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var a in Model)
                        {
                            <tr>
                                <td class="fw-semibold">@a.TakmaAd</td>
                                <td>@a.AdSoyad</td>
                                <td class="font-monospace small">@Bicim.Iban(a.Iban)</td>
                                <td class="text-end text-nowrap">
                                    <a class="btn btn-sm btn-outline-primary" asp-action="Duzenle" asp-route-id="@a.Id" title="Düzenle"><i class="fas fa-pen"></i></a>
                                    <a class="btn btn-sm btn-outline-danger" asp-action="Sil" asp-route-id="@a.Id" title="Sil"><i class="fas fa-trash"></i></a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}