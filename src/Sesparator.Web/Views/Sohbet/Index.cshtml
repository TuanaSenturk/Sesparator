@{
    ViewData["Title"] = "Sesli Asistan";
}

<h1 class="mb-4">Sesli Asistan</h1>

<div class="card">
    <div class="card-header d-flex align-items-center">
        <i class="fas fa-robot me-2"></i>
        <span>Sesparator Asistan</span>
        <span class="badge bg-success ms-auto">Çevrimiçi</span>
    </div>

    <div class="card-body sohbet-govde" id="sohbetGovde">
        <div class="mesaj asistan">
            <div class="balon">Merhaba! Bakiye sorgulama, para transferi veya kart borcu gibi işlemleri konuşarak yapabilirsiniz.</div>
        </div>
    </div>


    <div class="card-footer">
        <form id="sohbetFormu" autocomplete="off">
            <div class="input-group">
                <button class="btn btn-danger" type="button" id="mikrofonButonu" title="Konuşmak için basın">
                    <i class="fas fa-microphone"></i>
                </button>
                <input type="text" class="form-control" id="mesajKutusu" maxlength="1000" placeholder="Mesajınızı yazın ya da mikrofona basıp konuşun..." />
                <button class="btn btn-primary" type="submit" id="gonderButonu">
                    <i class="fas fa-paper-plane"></i>
                </button>
            </div>
        </form>
        <small class="text-muted" id="sohbetDurumu"></small>
    </div>
</div>

@section Scripts {
    <script src="~/js/sohbet.js" asp-append-version="true"></script>
}
