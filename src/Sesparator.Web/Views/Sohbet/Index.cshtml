@{
    ViewData["Title"] = "Sesli Asistan";
}

<h1 class="mb-4">Sesli Asistan</h1>

<div class="card">
    <div class="card-header d-flex align-items-center">
        <i class="fas fa-robot me-2"></i>
        <span>Sesparator Asistan</span>
        <span class="badge bg-success ms-auto">Çevrimiçi</span>
    </div>

    <div class="card-body sohbet-govde">
        <div class="mesaj asistan">
            <div class="balon">Merhaba! Bakiye sorgulama, para transferi veya kart borcu gibi işlemleri konuşarak yapabilirsiniz.</div>
        </div>
    </div>


    <div class="card-footer">
        <div class="input-group">
            <button class="btn btn-danger" type="button" title="Konuşmak için basın">
                <i class="fas fa-microphone"></i>
            </button>
            <input type="text" class="form-control" placeholder="Mesajınızı yazın ya da mikrofona basıp konuşun..." />
            <button class="btn btn-primary" type="button">
                <i class="fas fa-paper-plane"></i>
            </button>
        </div>
    </div>
</div>
