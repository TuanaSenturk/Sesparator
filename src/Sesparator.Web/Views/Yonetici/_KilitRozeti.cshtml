@model DateTimeOffset?
@* Yönetici kilidi, hatalı denemelerden gelen geçici kilit ya da aktif *@
@if (KilitYardimcisi.YoneticiKilidiMi(Model))
{
    <span class="badge bg-danger"><i class="fas fa-lock me-1"></i>Kilitli</span>
}
else if (Model > DateTimeOffset.UtcNow)
{
    <span class="badge bg-warning text-dark" title="Hatalı giriş denemeleri nedeniyle">Geçici kilit</span>
}
else
{
    <span class="badge bg-success">Aktif</span>
}
