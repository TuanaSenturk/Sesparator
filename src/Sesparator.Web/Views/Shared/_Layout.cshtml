<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Sesparator</title>

    <!-- SB Admin teması (Bootstrap 5 dahil) -->
    <link rel="stylesheet" href="~/css/sb-admin.css" asp-append-version="true" />
    <!-- Font Awesome ikonları -->
    <script src="https://use.fontawesome.com/releases/v6.3.0/js/all.js" crossorigin="anonymous"></script>
</head>
<body class="sb-nav-fixed">

    @{
        var aktif = ViewContext.RouteData.Values["controller"]?.ToString();
    }

    <!-- Üst bar -->
    <nav class="sb-topnav navbar navbar-expand navbar-dark bg-dark">
        <a class="navbar-brand ps-3" asp-controller="Home" asp-action="Index">
            <i class="fas fa-microphone me-2"></i>Sesparator
        </a>
        <button class="btn btn-link btn-sm order-1 order-lg-0 me-4 me-lg-0" id="sidebarToggle" href="#!">
            <i class="fas fa-bars"></i>
        </button>
    </nav>

    <div id="layoutSidenav">
        <!-- Sol menü -->
        <div id="layoutSidenav_nav">
            <nav class="sb-sidenav accordion sb-sidenav-dark" id="sidenavAccordion">
                <div class="sb-sidenav-menu">
                    <div class="nav">
                        <div class="sb-sidenav-menu-heading">Genel</div>
                        <a class="nav-link @(aktif == "Home" ? "active" : "")" asp-controller="Home" asp-action="Index">
                            <div class="sb-nav-link-icon"><i class="fas fa-house"></i></div>
                            Ana Sayfa
                        </a>

                        <div class="sb-sidenav-menu-heading">Bankacılık</div>
                        <a class="nav-link @(aktif == "Hesap" ? "active" : "")" asp-controller="Hesap" asp-action="Index">
                            <div class="sb-nav-link-icon"><i class="fas fa-wallet"></i></div>
                            Hesaplarım
                        </a>
                        <a class="nav-link @(aktif == "Sohbet" ? "active" : "")" asp-controller="Sohbet" asp-action="Index">
                            <div class="sb-nav-link-icon"><i class="fas fa-comments"></i></div>
                            Sesli Asistan
                        </a>
                    </div>
                </div>
                <div class="sb-sidenav-footer">
                    <div class="small">Sesli Bankacılık Asistanı</div>
                    Sesparator
                </div>
            </nav>
        </div>

        <!-- Sayfa içeriği -->
        <div id="layoutSidenav_content">
            <main>
                <div class="container-fluid px-4 py-4">
                    @RenderBody()
                </div>
            </main>
            <footer class="py-4 bg-light mt-auto">
                <div class="container-fluid px-4">
                    <div class="small text-muted">&copy; 2026 Sesparator</div>
                </div>
            </footer>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/sb-admin.js" asp-append-version="true"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>